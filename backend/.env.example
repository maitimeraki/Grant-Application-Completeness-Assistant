# --- Server ---
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database / storage (defaults are fine for local dev) ---
# DATABASE_URL=sqlite:///./data/app.db
# DATA_DIR=./data
# STORAGE_DIR=./storage

# --- LLM (required for AI review; without a key you can still do manual review) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional: custom OpenAI-compatible endpoint (leave empty for the provider default)
LLM_BASE_URL=

# --- CORS (only needed for the Vite dev server) ---
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Sample data seeding (reviewer demo sets; see app/services/seed.py) ---
# WARNING: when an LLM key is set, seeding runs a REAL AI pipeline (costs LLM
# calls). Default is FALSE — set to true only if you want the demo samples.
SEED_ON_STARTUP=false
DATABASE_URL=your-database-url-here